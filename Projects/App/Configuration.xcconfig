// 저장소 기본값. 로컬 비밀값 파일이 있으면 그 값을 선택적으로 덮어씁니다.
MAPBOX_ACCESS_TOKEN =
SEOUL_API_KEY =

// 앱 화면 구현을 고릅니다. swiftui(기본) 또는 uikit
UI_IMPLEMENTATION = swiftui

// 자동 서명에 쓰는 개발 팀입니다. tuist generate 후 Xcode에서 팀을 다시 고르지 않아도 됩니다.
// 다른 팀으로 서명하려면 Secrets.xcconfig에 DEVELOPMENT_TEAM을 넣어 덮어씁니다.
DEVELOPMENT_TEAM = LGX4B4WC66

#include? "Secrets.xcconfig"
